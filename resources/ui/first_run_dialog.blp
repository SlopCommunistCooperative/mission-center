using Gtk 4.0;
using Adw 1;

template $FirstRunDialog: Adw.Dialog {
    default-widget: run_script;

    Box {
        orientation: vertical;
        valign: start;
        halign: start;
        margin-top: 12;
        margin-start: 12;
        margin-end: 12;
        margin-bottom: 12;
        spacing: 12;

        Label {
            styles [
                "title-1",
            ]

            wrap: true;
            wrap-mode: word_char;
            label: _("Enabling Additional Values");
        }

        Label main_text {
            halign: start;
            hexpand: true;
            use-markup: true;
            wrap: true;
            label: _("CPU power draw, per-process network usage and fans may require additional setup");
        }

        Label rapl_warning {
            halign: start;
            hexpand: true;
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;
            max-width-chars: 80;
            label: _("The setup makes the CPU energy counters readable by all users, which programs can abuse as a side channel to infer sensitive data (CVE-2020-8695 and CVE-2020-12912).");
        }

        Label notice {
            visible: false;
            halign: start;
            hexpand: true;
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;
            max-width-chars: 80;
        }

        Adw.WrapBox {
            child-spacing: 12;
            line-spacing: 12;

            Button {
                tooltip-text: "https://gitlab.com/mission-center-devs/mission-center/-/wikis/home";
                action-name: "app.open-wiki";

                Box {
                    spacing: 6;

                    Label {
                        label: _("Open Wiki");
                    }

                    Image {
                        icon-name: "external-link-symbolic";
                    }
                }
            }

            Box {
                spacing: 6;

                Box {
                    hexpand: true;
                    spacing: 6;

                    Adw.SplitButton run_script {
                        action-name: "setup.run";
                        menu-model: button_run_menu;
                        receives-default: true;

                        styles [
                            "suggested-action",
                        ]

                        Box {
                            spacing: 6;

                            Label {
                                label: _("Run Additional Setup");
                            }

                            Image {
                                icon-name: "padlock2-symbolic";
                            }
                        }
                    }

                    Adw.Spinner spinner {
                        visible: false;

                        accessibility {
                            label: _("Running the additional setup");
                        }
                    }
                }

                Button close {
                    label: _("Close");
                }
            }
        }
    }
}

menu button_run_menu {
    section {
        item (_("Revert Additional Setup"), "setup.revert")
        item (_("View Script"), "setup.view")
    }

    section {
        item (_("Copy Script Location"), "setup.copy-location")
        item (_("Copy Command"), "setup.copy-command")
        item (_("Copy Revert Command"), "setup.copy-revert-command")
    }
}
